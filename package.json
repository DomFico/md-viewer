{
  "name": "vscode-md-viewer",
  "publisher": "DominicFico",
  "displayName": "MD Viewer",
  "description": "General molecular dynamics dataset viewer",
  "version": "0.1.7",
  "license": "MIT",
  "icon": "docs/assets/logo/for_vscode_marketplace.png",
  "galleryBanner": {
    "color": "#101820",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DomFico/md-viewer.git"
  },
  "homepage": "https://github.com/DomFico/md-viewer",
  "bugs": {
    "url": "https://github.com/DomFico/md-viewer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:md-viewer.launch",
    "onCommand:md-viewer.openDataset",
    "onCommand:md-viewer.openDatasetWithOptions",
    "onCommand:md-viewer.runDependencyDiagnostics",
    "onCommand:md-viewer.selectPythonInterpreter",
    "onCommand:md-viewer.bootstrapRemoteRuntime"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "md-viewer.launch",
        "title": "Launch MD Viewer",
        "category": "MD Viewer"
      },
      {
        "command": "md-viewer.runDependencyDiagnostics",
        "title": "Run Dependency Diagnostics",
        "category": "MD Viewer"
      },
      {
        "command": "md-viewer.selectPythonInterpreter",
        "title": "Select Python Interpreter",
        "category": "MD Viewer"
      },
      {
        "command": "md-viewer.bootstrapRemoteRuntime",
        "title": "Bootstrap Remote Python Runtime",
        "category": "MD Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "md-viewer.launch",
          "when": "resourceExtname =~ /\\.(xyz|xtc|trr|dcd|nc|rst7|inpcrd|mdcrd|pdb|gro|parm7|prmtop)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MD Viewer",
      "properties": {
        "mdViewer.renderMode": {
          "type": "string",
          "enum": [
            "auto",
            "points",
            "points+bonds"
          ],
          "default": "auto",
          "description": "Select rendering strategy. Auto enables bonds only for small trajectories."
        },
        "mdViewer.maxAtomsForBonds": {
          "type": "number",
          "default": 2000,
          "description": "In Auto render mode, bonds are disabled if atom count exceeds this threshold."
        },
        "mdViewer.maxFramesBeforeDecimation": {
          "type": "number",
          "default": 1000,
          "description": "Skip frames on playback load if total frames exceed this. Improves load time & memory for huge trajectories."
        },
        "mdViewer.pythonInterpreter": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path or command name for the Python interpreter used by MD Viewer bridge scripts. On Remote SSH/HPC, set this on the remote host interpreter."
        },
        "mdViewer.bootstrapPipExtraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Optional extra arguments appended to MD Viewer bootstrap pip commands, for example custom --index-url or --trusted-host options for managed HPC package indexes."
        },
        "mdViewer.bootstrapPackageOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional bootstrap package requirement overrides by package name, for example { \"mdtraj\": \"mdtraj==1.11.1.post1\" }. Leave empty for the default modern package path."
        },
        "mdViewer.bootstrapAllowSourceBuild": {
          "type": "boolean",
          "default": false,
          "description": "Allow bootstrap to attempt source builds when no MDTraj wheel is available. Disabled by default because managed HPC systems often lack Python.h / python3-devel headers."
        },
        "mdViewer.backgroundColor": {
          "type": "string",
          "enum": [
            "black",
            "white"
          ],
          "default": "black",
          "description": "Choose the viewer background color for the 3D canvas."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.3.0"
  }
}
